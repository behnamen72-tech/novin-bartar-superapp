APP_NAME=Novin Bartar Super App
APP_ENV=development

# Local development example only. Change before any shared/staging/production use.
POSTGRES_DB=superapp
POSTGRES_USER=superapp
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://superapp:change-me-for-local-development@localhost:5432/superapp

# Comma-separated list; keep explicit origins instead of wildcard in real deployments.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# REQUIRED. Generate a random secret, for example:
# openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=novin-bartar-superapp
JWT_AUDIENCE=novin-bartar-superapp-api


# Documents Core (local development storage)
DOCUMENTS_STORAGE_ROOT=storage/documents
DOCUMENTS_MAX_FILE_SIZE_BYTES=52428800

# D2 CRM -> Virtual Store service-to-service integration (optional until Store service exists)
# Uncomment and set a dedicated random secret only when enabling these integration calls.
# COMMERCE_INTEGRATION_BASE_URL=https://virtual-store.internal.example
# COMMERCE_INTEGRATION_JWT_SECRET=<dedicated-random-secret-at-least-32-characters>
# COMMERCE_INTEGRATION_JWT_ISSUER=novin-bartar-superapp
# COMMERCE_INTEGRATION_JWT_AUDIENCE=virtual_store.integration
# COMMERCE_INTEGRATION_SERVICE_SUBJECT=super_app
# COMMERCE_INTEGRATION_TOKEN_TTL_SECONDS=300
# COMMERCE_INTEGRATION_TIMEOUT_SECONDS=3
# COMMERCE_INTEGRATION_MAX_ATTEMPTS=2
# COMMERCE_INTEGRATION_RETRY_BACKOFF_SECONDS=0.1
